{
  "id": "reflexes",
  "name": "Reflexes",
  "description": "An open safety harness for AI agents — plain-English policy checks on tool calls and replies, evaluated by a policy-steerable classifier.",
  "version": "0.1.1",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "configPath": {
        "type": "string",
        "description": "Path to reflexes.yaml (default: ~/.reflexes/reflexes.yaml)"
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "hooks": ["llm_input", "message_received", "session_end", "after_tool_call", "before_agent_run", "before_tool_call", "before_agent_finalize", "reply_payload_sending"]
  }
}
